  "custom_palette": {
    "_note": "User picks two colours: base (backgrounds) and accent. lerp(a,b,t) is linear RGB interpolation from a toward b by t.",
    "light": {
      "bg": "lerp(base,#FFFFFF,0.923)",
      "surface": "lerp(base,#FFFFFF,0.959)",
      "card": "#FFFFFF",
      "text": "lerp(base,#000000,0.700)",
      "muted": "lerp(base,accent,0.40)",
      "accent": "accent",
      "accent2": "base",
      "border": "lerp(base,#FFFFFF,0.758)",
      "tag": "lerp(base,#FFFFFF,0.841)",
      "btn-text": "isDark(accent) ? #FFFFFF : #1A1A1A",
      "timeline": "lerp(base,#FFFFFF,0.883)"
    },
    "dark": {
      "bg": "lerp(base,#000000,0.894)",
      "surface": "lerp(base,#000000,0.814)",
      "card": "lerp(base,#000000,0.731)",
      "text": "lerp(base,#FFFFFF,0.879)",
      "muted": "lerp(base,accent,0.70)",
      "accent": "accent",
      "accent2": "base",
      "border": "lerp(base,#000000,0.573)",
      "tag": "lerp(base,#000000,0.825)",
      "btn-text": "same value as dark bg",
      "timeline": "lerp(base,#000000,0.802)"
    },
    "defaults": {
      "base": "#7A5C3A",
      "accent": "#C4956A"
    },
    "isDark": "(r*299 + g*587 + b*114)/1000 < 128, with r,g,b in 0-255"
  }
